<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.polkaswap.chatgpt</string>
  <key>ProgramArguments</key>
  <array><string>/Users/administrator/apps/polkaswap-chatgpt/run-server.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/administrator/apps/polkaswap-chatgpt/current</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/administrator/apps/polkaswap-chatgpt/logs/server.out.log</string>
  <key>StandardErrorPath</key><string>/Users/administrator/apps/polkaswap-chatgpt/logs/server.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
