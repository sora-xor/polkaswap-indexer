NODE_ENV=development
PORT=4350
HOST=0.0.0.0
GRAPHQL_PATH=/graphql
# HTTP connection/resource bounds. Explicit malformed or out-of-range values
# fail startup instead of silently falling back.
HTTP_LISTEN_BACKLOG=4096
HTTP_SHUTDOWN_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=75000
HTTP_HEADERS_TIMEOUT_MS=80000
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_MAX_CONNECTIONS=10000
HTTP_MAX_HEADER_BYTES=16384
HTTP_MAX_REQUESTS_PER_SOCKET=1000
# Fixed-window protection uses the raw TCP peer address and deliberately ignores
# spoofable forwarding headers. Behind loopback ingress, set the peer ceiling to
# the global ceiling and enforce client-IP limits at the trusted TLS edge.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_MAX_KEYS=20000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=50000
# GraphQL POST accepts JSON only. Multipart uploads and request batching are off.
GRAPHQL_HTTP_MAX_BODY_BYTES=262144
GRAPHQL_HTTP_MAX_IN_FLIGHT=100
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_DOCUMENT_NODES=2000
GRAPHQL_MAX_FIELDS=500
GRAPHQL_MAX_ALIASES=50
GRAPHQL_MAX_FRAGMENT_SPREADS=100
GRAPHQL_MAX_OPERATION_COST=100000
GRAPHQL_ALLOW_INTROSPECTION=false
GRAPHQL_WS_MAX_PAYLOAD_BYTES=65536
GRAPHQL_WS_CONNECTION_INIT_TIMEOUT_MS=30000
GRAPHQL_WS_MAX_CONNECTIONS=1000
GRAPHQL_WS_MAX_CONNECTIONS_PER_CLIENT=16
# Shared across both the modern graphql-transport-ws protocol and the
# official wallet's legacy graphql-ws framing.
GRAPHQL_WS_MAX_OPERATIONS=2000
GRAPHQL_WS_MAX_OPERATIONS_PER_CONNECTION=20
# Bounds legacy-protocol messages waiting behind a slow init/send operation.
GRAPHQL_WS_MAX_PENDING_MESSAGES_PER_CONNECTION=64
# Bounded resolver cache; either value may be 0 to disable caching.
GRAPHQL_CACHE_MAX_ENTRIES=1000
GRAPHQL_CACHE_MAX_BYTES=67108864
GRAPHQL_CACHE_TTL_MS=2000
# Per-operation encoded JSON cap and aggregate repository materialization budget.
GRAPHQL_MAX_RESULT_BYTES=67108864
# Process-wide budget shared by HTTP requests and active modern/legacy WS
# emissions. Idle subscriptions do not reserve it; must be >= one max result.
GRAPHQL_EXECUTION_MEMORY_MAX_BYTES=536870912
POLKASWAP_INDEXER_BASE_URL=https://pi.soramitsu.io/graphql
STORAGE_ENGINE=postgres
DATABASE_URL=postgres://polkaswap:polkaswap@127.0.0.1:5432/polkaswap_indexer
SKIP_POSTGRES_MIGRATION=false
# Production Compose substitution inputs. The one-shot migration preflight
# rejects identical URLs, repeated role identities, unsafe URL controls, or
# different DB targets, then verifies live roles/least privilege before DDL.
# Never give either long-lived runtime the schema-owner URL.
# Do not set NODE_OPTIONS, NODE_TLS_REJECT_UNAUTHORIZED, or PG* variables in
# production; startup rejects process-level overrides of the reviewed DB policy.
POLKASWAP_MIGRATION_OWNER_DATABASE_URL=postgresql://pi_migration_owner:change-me@db.example/polkaswap_indexer?sslmode=verify-full
POLKASWAP_API_DATABASE_URL=postgresql://pi_api:change-me@db.example/polkaswap_indexer?sslmode=verify-full
POLKASWAP_WORKER_DATABASE_URL=postgresql://pi_worker:change-me@db.example/polkaswap_indexer?sslmode=verify-full
# Production one-shot migration deadlines remain unlimited unless an operator
# deliberately bounds a known production-scale validation/index build.
POLKASWAP_POSTGRES_MIGRATION_QUERY_TIMEOUT_MS=0
POLKASWAP_POSTGRES_MIGRATION_STATEMENT_TIMEOUT_MS=0
POSTGRES_POOL_MAX=20
# All watchers share one LISTEN client; two slots allow reconnect overlap.
POSTGRES_LISTEN_POOL_MAX=2
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_QUERY_TIMEOUT_MS=120000
POSTGRES_STATEMENT_TIMEOUT_MS=120000
# Schema validation and concurrent index builds may run for hours on production
# history. Zero disables their client/server execution deadlines.
POSTGRES_MIGRATION_QUERY_TIMEOUT_MS=0
POSTGRES_MIGRATION_STATEMENT_TIMEOUT_MS=0
POSTGRES_WATCH_QUEUE_MAX=1000
POSTGRES_WATCH_RECONNECT_MIN_DELAY_MS=100
POSTGRES_WATCH_RECONNECT_MAX_DELAY_MS=10000
ROCKSDB_PATH=./data/polkaswap-indexer.rocksdb
ROCKSDB_BLOCK_CACHE_MB=512
ROCKSDB_WRITE_BUFFER_MANAGER_MB=256
ROCKSDB_PARALLELISM=4
ROCKSDB_ENABLE_STATS=false
ROCKSDB_COMPACTION_MIN_FREE_GB=10
# Bounded LRU for repeated point reads and worker upsert comparisons; 0 disables.
ROCKSDB_DOCUMENT_CACHE_MAX=10000
ROCKSDB_DOCUMENT_CACHE_MAX_BYTES=268435456
ROCKSDB_WATCH_QUEUE_MAX=1000
# Fail closed before an unindexed/fallback query can scan an unbounded store.
ROCKSDB_QUERY_MAX_SCANNED_ROWS=100000
# Postgres-to-RocksDB migration uses a versioned append-only capture generation.
ROCKSDB_MIGRATION_BATCH_SIZE=5000
ROCKSDB_MIGRATION_BATCH_BYTES=67108864
ROCKSDB_CHANGE_REPLAY_BATCH_SIZE=10000
ROCKSDB_CHANGE_REPLAY_BATCH_BYTES=67108864
ROCKSDB_MIGRATION_FOLLOW=false
# Positive milliseconds, capped at 60000 to prevent overflow/busy-loop polling.
ROCKSDB_MIGRATION_FOLLOW_POLL_MS=2000
# Destructive source/log cleanup remains disabled unless explicitly requested.
ROCKSDB_DROP_CHANGE_TABLE=false
ROCKSDB_DROP_CHANGE_TABLE_CONFIRM=
POSTGRES_RECLAIM_DRY_RUN=true
POSTGRES_RECLAIM_CONFIRM=
# `large` drops the curated high-space set; `all-secondary` selects every
# non-primary index except explicit keep overrides. Overrides are comma-separated names.
POSTGRES_RECLAIM_MODE=large
POSTGRES_RECLAIM_EXTRA_DROP_INDEXES=
POSTGRES_RECLAIM_KEEP_INDEXES=
# Migration verification is exhaustive by default and reads Postgres in bounded
# batches. Set FULL=false only for a non-release diagnostic sample.
ROCKSDB_VERIFY_FULL=true
ROCKSDB_VERIFY_BATCH_SIZE=5000
ROCKSDB_VERIFY_SAMPLE_SIZE=100
ROCKSDB_AUDIT_SAMPLE_SIZE=1000
ROCKSDB_AUDIT_CHAIN_TIMEOUT_MS=10000
ROCKSDB_AUDIT_SKIP_CHAIN=false
# Unless the chain check is explicitly skipped, the release gate requires
# bounded finalized-head lag and state age in addition to full format/index validation.
ROCKSDB_AUDIT_MAX_LAG_BLOCKS=100
ROCKSDB_AUDIT_MAX_STATE_AGE_SECONDS=600
# Required for `yarn storage:compact:rocksdb`: indexes, documents,
# documents:<collection>, or explicit `all`.
ROCKSDB_COMPACT_PREFIX=
ROCKSDB_BACKUP_DIR=./data/polkaswap-indexer-rocksdb-backups
ROCKSDB_CHECKPOINT_PATH=
# Restore creates and validates a fresh unpredictable child of this directory.
ROCKSDB_RESTORE_PARENT_PATH=
ROCKSDB_RESTORE_BACKUP_ID=
# Benchmarks refuse the live path; create an offline checkpoint and put it here.
ROCKSDB_BENCHMARK_PATH=
ROCKSDB_BENCHMARK_ITERATIONS=10
SORA_WS_ENDPOINT=wss://mof2.sora.org
# Optional historical block-data endpoint; leave empty to use SORA_WS_ENDPOINT.
SORA_ARCHIVE_WS_ENDPOINT=
CHAIN_START_BLOCK=0
CHAIN_BATCH_SIZE=25
CHAIN_STATE_REFRESH_INTERVAL_BLOCKS=25
CHAIN_SNAPSHOT_INTERVAL_BLOCKS=25
CHAIN_STATE_FULL_RECONCILIATION_INTERVAL_BLOCKS=250
CHAIN_SHUTDOWN_TIMEOUT_MS=30000
CHAIN_RPC_TIMEOUT_MS=15000
CHAIN_RPC_MAX_IN_FLIGHT=256
# Hard retained-memory ceiling for all paged storage maps in one pinned projection.
CHAIN_DERIVED_STORAGE_LOAD_MAX_BYTES=268435456
CHAIN_DERIVED_STORAGE_CACHE_MAX_BYTES=67108864
CHAIN_ANALYTICS_INPUT_CACHE_MAX_BYTES=134217728
# Bounded historical/finalized block prefetch tuning.
CHAIN_BACKFILL_PREFETCH_CONCURRENCY=1
CHAIN_FINALIZED_CATCHUP_PREFETCH_CONCURRENCY=1
# 0 keeps price stream updates coupled to normal derived-state refreshes.
CHAIN_PRICE_STREAM_REFRESH_INTERVAL_BLOCKS=0
CHAIN_LEGACY_SORA_BLOCK_TYPES=false
# Worker-aware readiness requires the worker to stay within both bounds.
WORKER_READINESS_MAX_LAG_BLOCKS=25
WORKER_READINESS_MAX_STALENESS_SECONDS=120
# Standalone worker-only health and Prometheus listener (`/health`, `/metrics`).
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9464
WORKER_METRICS_MAX_IN_FLIGHT=10
