{
  "name": "polkaswap-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "start:combined": "node dist/src/combined.js",
    "start:worker": "node dist/src/worker/index.js",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dist": "node dist/src/db/migrate.js",
    "db:migrate:production": "tsx src/scripts/production-migrate.ts",
    "db:migrate:production:dist": "node dist/src/scripts/production-migrate.js",
    "storage:migrate:postgres-to-rocksdb": "tsx src/scripts/migrate-postgres-to-rocksdb.ts",
    "storage:migrate:postgres-to-rocksdb:dist": "node dist/src/scripts/migrate-postgres-to-rocksdb.js",
    "storage:verify:rocksdb": "tsx src/scripts/verify-rocksdb.ts",
    "storage:verify:rocksdb:dist": "node dist/src/scripts/verify-rocksdb.js",
    "storage:backup:rocksdb": "tsx src/scripts/backup-rocksdb.ts",
    "storage:backup:rocksdb:dist": "node dist/src/scripts/backup-rocksdb.js",
    "storage:restore:rocksdb": "tsx src/scripts/restore-rocksdb.ts",
    "storage:restore:rocksdb:dist": "node dist/src/scripts/restore-rocksdb.js",
    "storage:checkpoint:rocksdb": "tsx src/scripts/checkpoint-rocksdb.ts",
    "storage:checkpoint:rocksdb:dist": "node dist/src/scripts/checkpoint-rocksdb.js",
    "storage:compact:rocksdb": "tsx src/scripts/compact-rocksdb.ts",
    "storage:compact:rocksdb:dist": "node dist/src/scripts/compact-rocksdb.js",
    "storage:audit:rocksdb": "tsx src/scripts/audit-rocksdb.ts",
    "storage:audit:rocksdb:dist": "node dist/src/scripts/audit-rocksdb.js",
    "storage:benchmark:rocksdb": "tsx src/scripts/benchmark-rocksdb.ts",
    "storage:benchmark:rocksdb:dist": "node dist/src/scripts/benchmark-rocksdb.js",
    "storage:reclaim:postgres-index-space": "tsx src/scripts/reclaim-postgres-index-space.ts",
    "storage:reclaim:postgres-index-space:dist": "node dist/src/scripts/reclaim-postgres-index-space.js",
    "storage:cleanup:postgres-rocksdb-capture": "tsx src/scripts/cleanup-postgres-rocksdb-capture.ts",
    "storage:cleanup:postgres-rocksdb-capture:dist": "node dist/src/scripts/cleanup-postgres-rocksdb-capture.js",
    "seed:swap-chart": "tsx src/dev/seedSwapChartData.ts",
    "audit:deployment-evidence": "bash scripts/audit-deployment-evidence.sh",
    "audit:dependencies": "yarn npm audit --all --recursive --severity low --no-deprecations",
    "audit:dependencies:production": "yarn npm audit --all --recursive --environment production --severity low --no-deprecations",
    "generate:deployment-evidence-template": "bash scripts/generate-deployment-evidence-template.sh",
    "smoke:production": "tsx src/scripts/production-smoke.ts",
    "test:deployment-evidence-audit": "bash scripts/test-deployment-evidence-audit.sh",
    "test:deployment-evidence-template": "bash scripts/test-deployment-evidence-template.sh",
    "test:deployment-manifest": "bash scripts/test-deployment-manifest.sh",
    "test:production-database-deployment": "bash scripts/test-production-database-deployment.sh",
    "test:production-smoke": "vitest run tests/production-smoke.spec.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@graphql-tools/schema": "^10.0.36",
    "@harperfast/rocksdb-js": "2.4.0",
    "@polkadot/api": "16.5.6",
    "@sora-substrate/type-definitions": "1.46.3",
    "graphql": "^16.14.2",
    "graphql-ws": "6.1.0",
    "graphql-yoga": "^5.21.2",
    "pg": "^8.22.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.10"
  }
}
