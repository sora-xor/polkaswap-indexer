{
  "name": "polkaswap-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "start:combined": "node dist/src/combined.js",
    "start:worker": "node dist/src/worker/index.js",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dist": "node dist/src/db/migrate.js",
    "storage:migrate:postgres-to-rocksdb": "tsx src/scripts/migrate-postgres-to-rocksdb.ts",
    "storage:verify:rocksdb": "tsx src/scripts/verify-rocksdb.ts",
    "storage:backup:rocksdb": "tsx src/scripts/backup-rocksdb.ts",
    "storage:restore:rocksdb": "tsx src/scripts/restore-rocksdb.ts",
    "storage:checkpoint:rocksdb": "tsx src/scripts/checkpoint-rocksdb.ts",
    "storage:compact:rocksdb": "tsx src/scripts/compact-rocksdb.ts",
    "storage:reclaim:postgres-index-space": "tsx src/scripts/reclaim-postgres-index-space.ts",
    "storage:cleanup:postgres-rocksdb-capture": "tsx src/scripts/cleanup-postgres-rocksdb-capture.ts",
    "seed:swap-chart": "tsx src/dev/seedSwapChartData.ts",
    "smoke:production": "tsx src/scripts/production-smoke.ts",
    "test:production-smoke": "vitest run tests/production-smoke.spec.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@graphql-tools/schema": "^10.0.30",
    "@harperfast/rocksdb-js": "^2.3.0",
    "@polkadot/api": "16.5.4",
    "@sora-substrate/type-definitions": "1.46.3",
    "graphql": "^16.13.1",
    "graphql-ws": "6.0.7",
    "graphql-yoga": "^5.16.2",
    "pg": "^8.16.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
